{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "test:unit": {
      "outputs": []
    },
    "test:emulator": {
      "outputs": [],
      "cache": false
    },
    "test:real": {
      "outputs": [],
      "cache": false
    }
  }
}
